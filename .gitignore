# OS-specific files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Text Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Other editors
*~
*.swp
*.swo
.project
.classpath
.cproject
.settings/

# Node.js & Web build tools (if utilized in the future)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.npm/
.eslintcache
.stylelintcache
.prettiercache
.parcel-cache
.cache/
.next/
.nuxt/
out/
dist/
build/
.yarn/
.pnpm-store/

# Logs and Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python (if scripting or local tools are introduced)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Local Environment and Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# Temporary and backup files
# ------------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.swp
*~
